{
  "id": "stavgayer.currents-ground",
  "name": "Currents surface",
  "version": "1.3.0",
  "type": "background",
  "api": 1,
  "entry": "index.js",
  "options": {
    "drift": {
      "type": "number",
      "default": 4,
      "min": 1,
      "max": 30,
      "label": "Minutes for one drift of the surface"
    },
    "fps": {
      "type": "number",
      "default": 30,
      "min": 10,
      "max": 60,
      "label": "Frames per second of the surface"
    },
    "scale": {
      "type": "number",
      "default": 0.5,
      "min": 0.25,
      "max": 1,
      "label": "Render scale of the surface"
    }
  }
}
